ENV=dev
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-me-to-64-random-chars
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
COOKIE_SAMESITE=lax            # use "none" if frontend and API are on different sites (Vercel + Render)
GEMINI_API_KEY=your_GEMINI_API_KEY
AI_MODEL=gemini-3.8-flash      # verify the current model name in Google AI Studio
AI_PAID_TIER=false             # set true ONLY on a Gemini plan whose terms exclude training on your data
MODAL_TOKEN_ID=ak-your_token_id
MODAL_TOKEN_SECRET=as-your_token_secret
FREE_RUNS_PER_MONTH=15
PRO_RUNS_PER_MONTH=300
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Persona Pulse AI <no-reply@example.com>
